{
  "manifest_version": 3,
  "name": "YouTube DJ",
  "version": "0.1.0",
  "description": "Beatmatch and mix YouTube videos like a DJ",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube DJ"
  },
  "web_accessible_resources": [
    {
      "resources": ["controller.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
